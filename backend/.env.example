# ====== 数据库与缓存池 ======
# PostgreSQL 极速事务落盘连接地址
DATABASE_URL=postgres://postgres:123456@localhost:5432/flow_alpha?sslmode=disable
# REDIS_URL=redis://localhost:6379/1

# ====== 流式监听 (Firehose / Substreams) 配置 ======
# Pinax 免费/付费网络抓取节点端口 (以太坊主网举例)
FIREHOSE_ENDPOINT=eth.substreams.pinax.network:443

# 您的专属鉴权 JWT Token (请登录 https://app.pinax.network 获取分配)
FIREHOSE_JWT=ey...请在此处粘贴您的JWT...

# ====== 启动基准游标与目标 ======
# 初次系统断点启动位置 (如果不依赖历史全量同步，设为近期的目标区块高度)
START_BLOCK_NUM=18000000

# 第三方编译好的子流包名及处理入口 (后续在此替换您自己编写的 Solana/Eth 高级处理模型)
SUBSTREAMS_PACKAGE=https://github.com/streamingfast/substreams-uniswap-v3/releases/download/v0.2.8/substreams.spkg
SUBSTREAMS_MODULE=map_pools_created
